<bpmn:dataObject id="DO_Alerta" name="Alerta"/><bpmn:dataObjectReference id="DOref_Alerta" name="Alerta" dataObjectRef="DO_Alerta"/>
<bpmn:dataObject id="DO_Orden" name="Orden de mantenimiento"/><bpmn:dataObjectReference id="DOref_Orden" name="Orden de mantenimiento" dataObjectRef="DO_Orden"/>
<bpmn:textAnnotation id="A1"><bpmn:text>Equipo crítico: su falla detiene la línea o compromete la cadena de frío (campo es_critico).</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="J1" targetRef="A1" associationDirection="None"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Meta M1: notificar al técnico en 30 s o menos desde que la lectura sale del umbral.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A2" sourceRef="S5" targetRef="A2" associationDirection="None"/>
<bpmn:textAnnotation id="A3"><bpmn:text>Meta M6: reducir 20 % el MTTR. Si hubo repuesto, descuenta stock.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A3" sourceRef="S7" targetRef="A3" associationDirection="None"/>
</bpmn:process>
