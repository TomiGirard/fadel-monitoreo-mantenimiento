<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Fadel" targetNamespace="http://fadel.example/tpi">
<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Part_Sens" name="Equipo monitoreado (sensores y PLC de la planta)"/>
<bpmn:participant id="Part_Fadel" name="Fadel S.A. - Planta Pronunciamiento" processRef="Process_Fadel"/>
<bpmn:participant id="Part_Prov" name="Proveedor de repuestos"/>
<bpmn:messageFlow id="m1" name="Lectura (valor, unidad, fecha y hora)" sourceRef="Part_Sens" targetRef="S1"/>
<bpmn:messageFlow id="m2" name="Pedido de repuesto" sourceRef="C1" targetRef="Part_Prov"/>
<bpmn:messageFlow id="m3" name="Aviso de entrega del repuesto" sourceRef="Part_Prov" targetRef="CT"/>
</bpmn:collaboration>
<bpmn:process id="Process_Fadel" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L1" name="Jefatura de Mantenimiento">
<bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L2" name="Técnico de Mantenimiento">
<bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L3" name="Sistema de monitoreo (automatizado)">
<bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>DOref_Alerta</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L4" name="Compras y Pañol">
<bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>EB</bpmn:flowNodeRef>
<bpmn:flowNodeRef>CT</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>TM</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Lectura de sensor recibida"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="S1_def"/></bpmn:startEvent>
<bpmn:businessRuleTask id="S2" name="Registrar y evaluar la lectura contra los umbrales"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G1" name="¿Lectura fuera de umbral?"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Lectura normal: sin alerta"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="S4" name="Generar alerta y asignar criticidad"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA1"><bpmn:targetRef>DOref_Alerta</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:scriptTask>
<bpmn:exclusiveGateway id="G2" name="¿Equipo crítico?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="J1" name="Autorizar prioridad y recursos de la reparación"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="S5" name="Notificar al técnico de guardia"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="T1" name="Confirmar recepción y abrir orden de mantenimiento"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T2" name="Diagnosticar la falla"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="¿Requiere repuesto?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S6" name="Verificar stock del repuesto"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G4" name="¿Hay stock del repuesto?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="C1" name="Solicitar el repuesto al proveedor"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="EB" name=""><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f21</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="CT" name="Repuesto recibido"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:messageEventDefinition id="CT_def"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="C2" name="Registrar el ingreso del repuesto al stock"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="TM" name="Pasan 48 h sin entrega"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:timerEventDefinition id="TM_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:userTask id="C3" name="Informar la demora a la Jefatura de Mantenimiento"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E4" name="Demora escalada a la Jefatura"><bpmn:incoming>f23</bpmn:incoming></bpmn:endEvent>
<bpmn:manualTask id="P1" name="Entregar el repuesto al técnico"><bpmn:incoming>f15</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="T4" name="Ejecutar la reparación y probar el equipo"><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="T5" name="Cerrar la orden de mantenimiento"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA2"><bpmn:targetRef>DOref_Orden</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:scriptTask id="S7" name="Actualizar stock y calcular tiempo de reparación (MTTR)"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="G5" name="¿Stock por debajo del mínimo?"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing><bpmn:outgoing>f29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E2" name="Orden cerrada: equipo operativo"><bpmn:incoming>f28</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="C4" name="Generar solicitud de compra interna"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E3" name="Orden cerrada y reposición solicitada"><bpmn:incoming>f30</bpmn:incoming></bpmn:endEvent>
